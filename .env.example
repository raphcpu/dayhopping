# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://DEINPROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → Maps SDK for Android + Maps SDK for iOS aktivieren
GOOGLE_MAPS_API_KEY=

# Wird von "eas init" vergeben (für Push nötig)
EAS_PROJECT_ID=

# Optional: eigene App-Kennung und Firebase-Datei für Android-Push
# APP_IDENTIFIER=de.deinname.dayhop
# GOOGLE_SERVICES_JSON=./google-services.json

# Betreiberangaben für Datenschutzerklärung und Kontakt (erscheinen in der App)
EXPO_PUBLIC_LEGAL_NAME=
EXPO_PUBLIC_LEGAL_ADDRESS=
EXPO_PUBLIC_LEGAL_EMAIL=
# z. B. "EU (Frankfurt)" – die Region deines Supabase-Projekts
EXPO_PUBLIC_LEGAL_HOSTING_REGION=
